# "true" = use built-in mock data (no backend needed). "false" = call the FastAPI backend.
VITE_USE_MOCK=true

# Leave empty: the dashboard calls /api on its own dev server, which forwards to BACKEND_URL.
# (Only set a full URL to skip the proxy; the backend must then allow CORS.)
VITE_API_BASE_URL=

# Where the dev-server proxy sends /api requests (the FastAPI backend).
BACKEND_URL=http://localhost:8000


# How often the live feed and incidents refresh (ms). The backend asks for 2-3 s.
VITE_POLL_INTERVAL_MS=2500
