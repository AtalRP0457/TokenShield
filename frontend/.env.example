# "true" = use built-in mock data (no backend needed). "false" = call the FastAPI backend.
VITE_USE_MOCK=true

# Base URL of the FastAPI backend (no trailing slash).
VITE_API_BASE_URL=http://localhost:8000

# Optional WebSocket URL for live events. Leave empty to use polling instead.
# Example: ws://localhost:8000/ws/events
VITE_WS_URL=

# Polling interval (ms) used when no WebSocket is configured or it fails.
VITE_POLL_INTERVAL_MS=5000
