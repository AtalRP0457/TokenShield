# Local dev: SQLite. For Tiger Data use:
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:PORT/tsdb?sslmode=require
DATABASE_URL=sqlite:///./tokenshield.db
GEMINI_API_KEY=
# Flash-Lite has a much larger free daily quota than Flash.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.8-flash
DISCORD_WEBHOOK_URL=
# Optional extra alert channels (high/critical perils). Leave blank to turn off.
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
ENVIRONMENT=development
API_KEY=development-key
MAX_REPEATED_CALLS=5
MAX_CONSECUTIVE_FAILURES=5
MAX_SEQUENCE_REPEATS=3
MAX_TASK_TOKENS=50000
MAX_TASK_COST=2.00
MAX_TASK_DURATION_SECONDS=600
INCIDENT_COOLDOWN_SECONDS=60
FRONTEND_ORIGIN=http://localhost:5173
